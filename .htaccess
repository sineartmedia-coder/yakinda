# Yakında Kurye — Apache ayarları (desteklenmeyen modüller sessizce atlanır)

# Panelden yayınlanan içerik her ziyarette güncel yüklensin
<IfModule mod_headers.c>
  <FilesMatch "^(content\.js|.*\.html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Gizli dosyalara (.git, .htaccess vb.) ve belgelere erişimi engelle
<FilesMatch "^\.|\.(md|log|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.git(/|$) - [F,L]
</IfModule>

# Görsel, stil ve betikler tarayıcıda önbelleğe alınsın
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
</IfModule>

# Metin dosyalarını sıkıştır
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
